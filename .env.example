MOONSHOT_API_KEY=sk-your-key-here
MINIMAX_API_KEY=your-key-here
DASHSCOPE_API_KEY=sk-your-key-here
BAILIAN_API_KEY=sk-your-key-here  # 与 DASHSCOPE_API_KEY 相同，阿里云 DashScope key
ARK_API_KEY=your-key-here
